			<&pwm0 1 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 2 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 3 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 0 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 1 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 2 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 3 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 0 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 1 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 2 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 3 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 0 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 1 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 2 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 3 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 0 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 1 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 2 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 3 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 0 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 1 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 2 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 3 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 0 PWM_HZ(500) PWM_POLARITY_NORMAL>,
			<&pwm0 1 PWM_HZ(500) PWM_POLARITY_NORMAL>,
