{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "typeRoots": ["../velxio/frontend/node_modules/@types"],
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "paths": {
      "@velxio/*": ["../velxio/frontend/src/*"],
      "@pro/*": ["../velxio/frontend/src/__pro_stub__/*"],
      "@parts/*": ["../parts/*"],
      "@harness/*": ["../harness/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
