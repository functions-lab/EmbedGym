{"target": "atmega2560_arduino", "part": "ky-038-sound-sensor", "name": "mic", "pin": 7}
{"target": "esp32s3_espidf", "part": "ky-038-sound-sensor", "name": "mic", "pin": 14}
{"target": "nrf52840_zephyr", "part": "ky-038-sound-sensor", "name": "mic", "pin": "P1.10"}
{"at": 200, "parse": "Sound edges: {se:d}"}
{"at": 200, "parse": "Quiet edges: {qe:d}"}
{"at": 200, "parse": "Glitch edges: {ge:d}"}
{"at": 200, "parse": "{loud:s}"}
{"at": 200, "expect": "len(@se) == 0 && len(@qe) == 0 && len(@ge) == 0 && len(@loud) == 0"}
{"at": 200, "expect": "mic.detected == false"}
{"at": 300, "set": "mic.soundLevel = 900"}
{"at": 600, "expect": "mic.detected == true"}
{"at": 600, "parse": "Sound edges: {se:d}"}
{"at": 600, "parse": "Quiet edges: {qe:d}"}
{"at": 600, "parse": "Glitch edges: {ge:d}"}
{"at": 600, "parse": "{loud:s}"}
{"at": 600, "parse": "Sound chatter: {sc1:d} {sc2:d}"}
{"at": 600, "expect": "11 <= @sc1[-1] && @sc1[-1] <= 13 && 23 <= @sc2[-1] && @sc2[-1] <= 25"}
{"at": 600, "expect": "len(@se) == 1 && @se[-1] == 3 && len(@qe) == 0"}
{"at": 600, "expect": "300 < @se.t[-1] && @se.t[-1] < 400"}
{"at": 600, "expect": "len(@loud) == 1 && @loud[-1] == 'LOUD'"}
{"at": 700, "set": "mic.soundLevel = 100"}
{"at": 1000, "expect": "mic.detected == false"}
{"at": 1000, "parse": "Sound edges: {se:d}"}
{"at": 1000, "parse": "Quiet edges: {qe:d}"}
{"at": 1000, "parse": "Glitch edges: {ge:d}"}
{"at": 1000, "parse": "{loud:s}"}
{"at": 1000, "expect": "len(@se) == 1 && len(@qe) == 1 && @qe[-1] == 1"}
{"at": 1000, "expect": "len(@loud) == 2 && @loud[-1] == 'QUIET'"}
{"at": 1100, "set": "mic.soundLevel = 600"}
{"at": 1400, "parse": "Sound edges: {se:d}"}
{"at": 1400, "parse": "Quiet edges: {qe:d}"}
{"at": 1400, "parse": "Glitch edges: {ge:d}"}
{"at": 1400, "parse": "{loud:s}"}
{"at": 1400, "expect": "len(@se) == 2 && @se[-1] == 3"}
{"at": 1400, "expect": "len(@loud) == 2"}
{"at": 1500, "set": "mic.threshold = 950"}
{"at": 1600, "expect": "mic.detected == false"}
{"at": 1600, "parse": "Sound edges: {se:d}"}
{"at": 1600, "parse": "Quiet edges: {qe:d}"}
{"at": 1600, "parse": "Glitch edges: {ge:d}"}
{"at": 1600, "parse": "{loud:s}"}
{"at": 1600, "expect": "len(@qe) == 2 && @qe[-1] == 1 && 1500 < @qe.t[-1]"}
{"at": 1700, "set": "mic.soundLevel = 930"}
{"at": 2000, "expect": "mic.detected == false"}
{"at": 2000, "parse": "Sound edges: {se:d}"}
{"at": 2000, "parse": "Quiet edges: {qe:d}"}
{"at": 2000, "parse": "Glitch edges: {ge:d}"}
{"at": 2000, "parse": "{loud:s}"}
{"at": 2000, "expect": "len(@se) == 2"}
{"at": 2000, "expect": "len(@loud) == 3 && @loud[-1] == 'LOUD'"}
{"at": 2100, "set": "mic.threshold = 512"}
{"at": 2400, "expect": "mic.detected == true"}
{"at": 2400, "parse": "Sound edges: {se:d}"}
{"at": 2400, "parse": "Quiet edges: {qe:d}"}
{"at": 2400, "parse": "Glitch edges: {ge:d}"}
{"at": 2400, "parse": "{loud:s}"}
{"at": 2400, "parse": "Sound chatter: {sc1:d} {sc2:d}"}
{"at": 2400, "expect": "11 <= @sc1[-1] && @sc1[-1] <= 13 && 23 <= @sc2[-1] && @sc2[-1] <= 25"}
{"at": 2400, "expect": "len(@se) == 3 && @se[-1] == 3 && len(@qe) == 2 && len(@ge) == 0 && 2100 < @se.t[-1]"}
