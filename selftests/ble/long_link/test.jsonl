{"at": 61000, "capture": "ticks = phone.ticks"}
{"at": 61000, "expect": "@ticks >= 58 && @ticks <= 60"}
{"at": 61000, "expect": "phone.ticks_steady == true"}
{"at": 61000, "parse": "TICK {tick:d}"}
{"at": 61000, "expect": "len(@tick) - @ticks >= 0 && len(@tick) - @ticks <= 1"}
{"at": 61000, "expect": "@tick[-1] == len(@tick)"}
{"at": 61000, "capture": "reads = phone.reads"}
{"at": 61000, "expect": "@reads >= 27 && @reads <= 31"}
{"at": 61000, "expect": "phone.reads_in_order == true"}
{"at": 61000, "parse": "READ {read:d}"}
{"at": 61000, "expect": "len(@read) - @reads >= 0 && len(@read) - @reads <= 1"}
{"at": 61000, "expect": "@read[-1] == len(@read)"}
{"at": 61000, "parse": "CONNECTED", "as": "conn"}
{"at": 61000, "expect": "len(@conn) == 1"}
{"at": 61000, "parse": "SUBSCRIBED {sub:d}"}
{"at": 61000, "expect": "len(@sub) == 1 && @sub[0] == 1"}
{"at": 61000, "parse": "DISCONNECTED reason={reason:s}"}
{"at": 61000, "expect": "len(@reason) == 0"}
