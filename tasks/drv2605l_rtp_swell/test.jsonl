{"at":6500,"expect":"@v.indexOf(127) > 0 && @v.indexOf(8, @v.indexOf(0, @v.indexOf(127))) > 0"}
{"at":6500,"expect":"Math.min(...@v.slice(@v.lastIndexOf(0, @v.indexOf(127)), @v.indexOf(8, @v.indexOf(0, @v.indexOf(127))))) == 0 && Math.max(...@v.slice(@v.lastIndexOf(0, @v.indexOf(127)), @v.indexOf(8, @v.indexOf(0, @v.indexOf(127))))) == 127"}
{"at":6500,"expect":"@v[@v.lastIndexOf(0, @v.indexOf(127)) + 1] == 8 && @v[@v.indexOf(127) - 1] == 120"}
{"at":6500,"expect":"@v.t[@v.indexOf(127)] - @v.t[@v.lastIndexOf(0, @v.indexOf(127))] >= 740 && @v.t[@v.indexOf(127)] - @v.t[@v.lastIndexOf(0, @v.indexOf(127))] <= 800"}
{"at":6500,"expect":"@v.t[@v.indexOf(64, @v.lastIndexOf(0, @v.indexOf(127)))] - @v.t[@v.lastIndexOf(0, @v.indexOf(127))] >= 340 && @v.t[@v.indexOf(64, @v.lastIndexOf(0, @v.indexOf(127)))] - @v.t[@v.lastIndexOf(0, @v.indexOf(127))] <= 400"}
{"at":6500,"expect":"@v.t[@v.lastIndexOf(127, @v.indexOf(0, @v.indexOf(127)))] - @v.t[@v.indexOf(127)] >= 20 && @v.t[@v.lastIndexOf(127, @v.indexOf(0, @v.indexOf(127)))] - @v.t[@v.indexOf(127)] <= 40"}
{"at":6500,"expect":"(@v[@v.lastIndexOf(127, @v.indexOf(0, @v.indexOf(127))) + 1] == 119 || @v[@v.lastIndexOf(127, @v.indexOf(0, @v.indexOf(127))) + 1] == 120) && (@v[@v.indexOf(0, @v.indexOf(127)) - 1] == 7 || @v[@v.indexOf(0, @v.indexOf(127)) - 1] == 8)"}
{"at":6500,"expect":"@v.t[@v.indexOf(0, @v.indexOf(127))] - @v.t[@v.lastIndexOf(127, @v.indexOf(0, @v.indexOf(127)))] >= 740 && @v.t[@v.indexOf(0, @v.indexOf(127))] - @v.t[@v.lastIndexOf(127, @v.indexOf(0, @v.indexOf(127)))] <= 800"}
{"at":6500,"expect":"20 * Math.max(@v.slice(@v.lastIndexOf(127, @v.indexOf(0, @v.indexOf(127))), @v.indexOf(0, @v.indexOf(127))).indexOf(63), @v.slice(@v.lastIndexOf(127, @v.indexOf(0, @v.indexOf(127))), @v.indexOf(0, @v.indexOf(127))).indexOf(64)) >= 340 && 20 * Math.max(@v.slice(@v.lastIndexOf(127, @v.indexOf(0, @v.indexOf(127))), @v.indexOf(0, @v.indexOf(127))).indexOf(63), @v.slice(@v.lastIndexOf(127, @v.indexOf(0, @v.indexOf(127))), @v.indexOf(0, @v.indexOf(127))).indexOf(64)) <= 400"}
{"at":6500,"expect":"Math.max(...@v.slice(@v.indexOf(0, @v.indexOf(127)), @v.indexOf(8, @v.indexOf(0, @v.indexOf(127))))) == 0 && Math.min(...@v.slice(@v.indexOf(0, @v.indexOf(127)), @v.indexOf(8, @v.indexOf(0, @v.indexOf(127))))) == 0"}
{"at":6500,"expect":"@v.t[@v.indexOf(8, @v.indexOf(0, @v.indexOf(127)))] - @v.t[@v.indexOf(0, @v.indexOf(127))] >= 980 && @v.t[@v.indexOf(8, @v.indexOf(0, @v.indexOf(127)))] - @v.t[@v.indexOf(0, @v.indexOf(127))] <= 1120"}
{"at":6500,"expect":"len(@n) >= 1 && len(@n) <= 2 && @n[0] == 1 && @n[-1] == len(@n)"}
{"at":6500,"expect":"len(@peak) - len(@n) >= 0 && len(@peak) - len(@n) <= 1"}
{"at":6500,"expect":"@peak.t[1] - @peak.t[0] >= 2500 && @peak.t[1] - @peak.t[0] <= 2700"}
{"at":6500,"expect":"@peak.t[0] - @v.t[@v.indexOf(127)] >= -20 && @peak.t[0] - @v.t[@v.indexOf(127)] <= 75"}
{"at":6500,"expect":"@n.t[0] - @v.t[@v.indexOf(0, @v.indexOf(127))] >= 980 && @n.t[0] <= @v.t[@v.indexOf(8, @v.indexOf(0, @v.indexOf(127)))] + 20"}
