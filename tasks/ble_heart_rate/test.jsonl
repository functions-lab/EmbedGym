{"target": "nrf52840_zephyr", "part": "max32664", "name": "bio", "pin": "P0.21"}
{"target": "nrf52840_zephyr", "part": "ble", "name": "ble"}
{"target": "nrf52840_zephyr", "peer": "peer.py", "name": "phone"}
{"target": "nrf52840_arduino", "part": "max32664", "name": "bio", "pin": "P0.21"}
{"target": "nrf52840_arduino", "part": "ble", "name": "ble"}
{"target": "nrf52840_arduino", "peer": "peer.py", "name": "phone"}
{"at": 0, "set": "bio.heartRate = 64"}
{"at": 10000, "expect": "phone.result == 'ok'"}
{"at": 10000, "expect": "phone.connected == true"}
{"at": 10000, "expect": "phone.connections == 1"}
{"at": 10000, "do": "phone.mark"}
{"at": 10000, "capture": "n0 = phone.notifications"}
{"at": 16000, "capture": "lo1 = phone.low"}
{"at": 16000, "capture": "hi1 = phone.high"}
{"at": 16000, "expect": "@lo1 == 64 && @hi1 == 64"}
{"at": 16000, "expect": "phone.detected > 0"}
{"at": 16000, "expect": "phone.undetected == 0"}
{"at": 16000, "expect": "phone.unsupported == 0"}
{"at": 16000, "capture": "n1 = phone.notifications"}
{"at": 16000, "expect": "@n1 - @n0 >= 5 && @n1 - @n0 <= 8"}
{"at": 16000, "capture": "p1 = phone.period_ms"}
{"at": 16000, "expect": "@p1 >= 800 && @p1 <= 1200"}
{"at": 16000, "set": "bio.heartRate = 143"}
{"at": 18000, "do": "phone.mark"}
{"at": 18000, "capture": "n2 = phone.notifications"}
{"at": 23000, "capture": "lo3 = phone.low"}
{"at": 23000, "capture": "hi3 = phone.high"}
{"at": 23000, "expect": "@lo3 == 143 && @hi3 == 143"}
{"at": 23000, "expect": "phone.detected > 0"}
{"at": 23000, "expect": "phone.undetected == 0"}
{"at": 23000, "expect": "phone.unsupported == 0"}
{"at": 23000, "capture": "n3 = phone.notifications"}
{"at": 23000, "expect": "@n3 - @n2 >= 4 && @n3 - @n2 <= 7"}
{"at": 23000, "capture": "p3 = phone.period_ms"}
{"at": 23000, "expect": "@p3 >= 800 && @p3 <= 1200"}
{"at": 23000, "set": "bio.status = 2"}
{"at": 25000, "do": "phone.mark"}
{"at": 25000, "capture": "n4 = phone.notifications"}
{"at": 30000, "expect": "phone.detected == 0"}
{"at": 30000, "expect": "phone.undetected >= 2"}
{"at": 30000, "expect": "phone.unsupported == 0"}
{"at": 30000, "capture": "n5 = phone.notifications"}
{"at": 30000, "expect": "@n5 - @n4 >= 4 && @n5 - @n4 <= 7"}
{"at": 30000, "set": "bio.status = 3"}
{"at": 30000, "set": "bio.heartRate = 52"}
{"at": 30000, "do": "phone.unsubscribe"}
{"at": 31000, "expect": "phone.result == 'ok'"}
{"at": 34000, "expect": "phone.after_off == 0"}
{"at": 34000, "do": "phone.subscribe"}
{"at": 34000, "do": "phone.mark"}
{"at": 34000, "capture": "n6 = phone.notifications"}
{"at": 35000, "expect": "phone.result == 'ok'"}
{"at": 39000, "capture": "lo7 = phone.low"}
{"at": 39000, "capture": "hi7 = phone.high"}
{"at": 39000, "expect": "@lo7 == 52 && @hi7 == 52"}
{"at": 39000, "expect": "phone.detected > 0"}
{"at": 39000, "expect": "phone.undetected == 0"}
{"at": 39000, "expect": "phone.unsupported == 0"}
{"at": 39000, "capture": "n7 = phone.notifications"}
{"at": 39000, "expect": "@n7 - @n6 >= 3 && @n7 - @n6 <= 7"}
{"at": 39000, "do": "phone.disconnect"}
{"at": 40000, "expect": "phone.result == 'ok'"}
{"at": 40000, "expect": "phone.connected == false"}
{"at": 40000, "expect": "phone.disconnects == 1"}
{"at": 40000, "set": "bio.heartRate = 187"}
{"at": 41000, "do": "phone.connect"}
{"at": 45000, "expect": "phone.result == 'ok'"}
{"at": 45000, "expect": "phone.connected == true"}
{"at": 45000, "expect": "phone.connections == 2"}
{"at": 45000, "do": "phone.mark"}
{"at": 45000, "capture": "n8 = phone.notifications"}
{"at": 50000, "capture": "lo9 = phone.low"}
{"at": 50000, "capture": "hi9 = phone.high"}
{"at": 50000, "expect": "@lo9 == 187 && @hi9 == 187"}
{"at": 50000, "expect": "phone.detected > 0"}
{"at": 50000, "expect": "phone.undetected == 0"}
{"at": 50000, "expect": "phone.unsupported == 0"}
{"at": 50000, "capture": "n9 = phone.notifications"}
{"at": 50000, "expect": "@n9 - @n8 >= 4 && @n9 - @n8 <= 7"}
{"at": 50000, "capture": "p9 = phone.period_ms"}
{"at": 50000, "expect": "@p9 >= 800 && @p9 <= 1200"}
{"at": 50000, "set": "bio.status = 1"}
{"at": 50000, "do": "phone.disconnect"}
{"at": 51000, "expect": "phone.result == 'ok'"}
{"at": 51000, "expect": "phone.connected == false"}
{"at": 51000, "expect": "phone.disconnects == 2"}
{"at": 52000, "do": "phone.connect"}
{"at": 56000, "expect": "phone.result == 'ok'"}
{"at": 56000, "expect": "phone.connected == true"}
{"at": 56000, "expect": "phone.connections == 3"}
{"at": 56000, "do": "phone.mark"}
{"at": 56000, "capture": "n10 = phone.notifications"}
{"at": 60000, "expect": "phone.detected == 0"}
{"at": 60000, "expect": "phone.undetected >= 2"}
{"at": 60000, "expect": "phone.unsupported == 0"}
{"at": 60000, "capture": "n11 = phone.notifications"}
{"at": 60000, "expect": "@n11 - @n10 >= 3 && @n11 - @n10 <= 6"}
{"at": 60000, "expect": "phone.disconnects == 2"}
{"at": 60000, "expect": "phone.indications == 0"}
{"at": 60000, "expect": "phone.bad_values == 0"}
