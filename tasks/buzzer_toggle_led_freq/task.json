        "signal": "GPIO11"
      },
      "Buzzer": {
        "signal": "GPIO10"
      },
      "Tactile Switch": {
        "signal": "GPIO12"
      }
    },
    "esp32s3_arduino": {
      "LED": {
        "signal": "GPIO11"
      },
      "Buzzer": {
        "signal": "GPIO10"
      },
      "Tactile Switch": {
