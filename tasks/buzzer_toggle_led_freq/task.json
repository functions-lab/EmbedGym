      "LED": {
        "signal": "D4"
      },
      "Buzzer": {
        "signal": "D3"
      },
      "Tactile Switch": {
        "signal": "D2"
      }
    },
    "atmega328p_arduino": {
      "LED": {
        "signal": "D4"
      },
      "Buzzer": {
        "signal": "D3"
      },
      "Tactile Switch": {
        "signal": "D2"
      }
    },
    "esp32s3_espidf": {
